# MySQL Database Configuration
MYSQL_DATABASE=studyflow
MYSQL_USER=studyflow
MYSQL_PASSWORD=studyflow_password
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_HOST=localhost
MYSQL_PORT=3306

# FastAPI Database URL (MySQL)
DATABASE_URL=mysql+aiomysql://studyflow:studyflow_password@localhost:3306/studyflow

# JWT Security
JWT_SECRET_KEY=studyflow-super-secret-jwt-key-for-mca-project-change-me-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# API Settings
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","*"]
UPLOAD_DIR=uploads

# Next.js Web App API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
