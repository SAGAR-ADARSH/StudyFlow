# MySQL Database Configuration
MYSQL_DATABASE=studyflow
MYSQL_USER=studyflow
MYSQL_PASSWORD=studyflow_password
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_HOST=localhost
MYSQL_PORT=3306

# FastAPI Database URL (MySQL)
DATABASE_URL=mysql+aiomysql://studyflow:studyflow_password@localhost:3306/studyflow

# JWT Security (replace with `openssl rand -hex 32` before starting the API)
JWT_SECRET_KEY=replace-this-with-a-random-32-byte-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=studyflow-api
ACCESS_TOKEN_EXPIRE_MINUTES=60

# API Settings
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
UPLOAD_DIR=uploads

# Next.js Web App API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
